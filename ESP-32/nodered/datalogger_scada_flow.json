    },
    {
        "id": "fn_split_telemetry",
        "type": "function",
        "z": "tab_scada_wq01",
        "name": "Process & Format CSV",
        "func": "const d = msg.payload;\nif (!d || typeof d.value === 'undefined') return null;\n\nconst now = new Date();\nconst iso = now.toISOString();\n\nconst msgVal = {\n    payload: Number(d.value),\n    topic: `${d.sensor} (${d.unit})`\n};\n\nconst msgMa = {\n    payload: `${Number(d.ma).toFixed(2)} mA (${Number(d.adc_mv).toFixed(0)} mV)`\n};\n\nconst msgFault = {\n    payload: `${d.fault} | RSSI ${d.rssi} dBm`\n};\n\nconst msgMode = {\n    payload: d.cal_mode ? 'KALIBRASI LOKAL' : 'MONITORING'\n};\n\nconst csvRow = `${iso},${d.device},${d.sensor},${d.unit},${d.adc_mv},${d.ma},${d.value},${d.fault},${d.rssi}`;\nconst msgCsv = {\n    payload: csvRow\n};\n\nreturn [msgVal, msgMa, msgFault, msgMode, msgCsv];",
        "outputs": 5,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 570,
        "y": 200,
        "wires": [
            ["ui_gauge_val", "ui_chart_val"],
            ["ui_txt_ma"],
            ["ui_txt_fault"],
            ["ui_txt_mode"],
            ["file_csv_log"]
        ]
    },
