    {
        "id": "fn_format_cal_status",
        "type": "function",
        "z": "tab_scada_wq01",
        "name": "Format Status NVS",
        "func": "const c = msg.payload;\nif (!c) return null;\n\nconst summary = {\n    payload: `${c.sensor} (${c.unit}) | Lo: ${c.cal_ma_low}mA->${c.val_low} | Hi: ${c.cal_ma_high}mA->${c.val_high} | ADC: ${c.mv_4ma}-${c.mv_20ma}mV [${c.last_event}]`\n};\n\nconst toast = {\n    payload: `Kalibrasi [${c.last_event}]: ${c.sensor} (${c.val_low} .. ${c.val_high} ${c.unit})`\n};\n\nreturn [summary, toast];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 570,
        "y": 400,
        "wires": [["ui_txt_cal_summary"], ["ui_toast_cal"]]
    },
